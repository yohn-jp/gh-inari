  "files": [
    "dist",
    "!dist/dashboard/**",
    "!dist/relay/cloudflare-repository-relay.d.ts",
    "!dist/relay/cloudflare-repository-relay.js",
    "!dist/relay/cloudflare-repository-relay.js.map",
    "branch-naming-authority.mjs",
    "branch-naming-authority.d.mts",
    "README.md",
    "LICENSE",
    ".codex-plugin",
    "skills",
    "scripts/certification-evidence.mjs",
    "scripts/certification-evidence.d.mts"
  ],
  "scripts": {
    "preinstall": "node -e \"const p='./scripts/unlink-worktree-node-modules.mjs';require('node:fs').existsSync(p)&&require('node:child_process').execFileSync(process.execPath,[p],{stdio:'inherit'})\"",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs && node scripts/build-setup-console.mjs && pnpm --dir apps/dashboard build",
    "setup-console:build": "node scripts/build-setup-console.mjs",
    "test:setup-browser": "pnpm run build && node scripts/run-setup-browser-tests.mjs",
    "start": "node dist/index.js",
    "test": "node --test --import tsx --test-skip-pattern='packed installed CLI certifies|#1122 certifies the packed installed CLI|packed setup console certifies real Chromium controls' \"src/*.test.ts\" \"src/**/*.test.ts\" \"apps/setup-console/*.test.ts\" \"test/**/*.test.mjs\"",
    "certify:setup": "wireit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.mjs' 'test/**/*.mjs' 'eslint.config.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke-test": "node scripts/smoke-test.mjs",
    "self-dogfood": "node --import tsx scripts/self-dogfood.mjs",
    "certify:lifecycle": "node scripts/implementation-lifecycle-certification.mjs",
    "templates:check": "node --import tsx src/index.ts template sync --check",
    "test:package": "pnpm run build && node scripts/run-package-suite.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "hosted-worker:build": "node --import tsx scripts/build-hosted-worker.mjs",
    "dashboard:test": "wireit",
    "dashboard:build": "wireit",
    "worker:deploy": "wrangler deploy",
    "worker:dev": "wrangler dev",
    "verify": "wireit",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "readme:check": "node scripts/readme-integrity.mjs",
    "boundaries:check": "node scripts/check-runtime-boundaries.mjs",
    "certify:release": "node scripts/release-preparation-certification.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "xstate": "5.33.2",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.2",
    "@xstate/graph": "3.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "wireit": "0.14.13",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "executableFiles": [
      "dist/index.js"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohn-jp/gh-inari.git"
  },
  "homepage": "https://github.com/yohn-jp/gh-inari#readme",
  "bugs": {
    "url": "https://github.com/yohn-jp/gh-inari/issues"
  },
  "keywords": [
    "github",
    "gh",
    "cli",
    "issue",
    "pull-request",
    "templates",
    "governance",
    "repository-governance",
    "deterministic",
    "developer-tools",
    "ai-agents"
  ],
  "main": "dist/index.js",
  "author": "",
  "types": "./dist/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "wireit": {
    "verify": {
      "dependencies": [
        "format:check",
        "readme:check",
        "boundaries:check",
        "lint",
        "test",
        "dashboard:test",
        "dashboard:build",
        "templates:check",
        "worker:build",
        "verify:package",
        "certify:setup"
      ]
    },
    "dashboard:test": {
      "command": "pnpm --dir apps/dashboard test"
    },
    "dashboard:build": {
      "command": "pnpm --dir apps/dashboard build"
    },
    "verify:package": {
      "command": "pnpm run test:package",
      "dependencies": [
        "typecheck"
      ]
    },
    "certify:setup": {
      "command": "node --test --import tsx test/setup-application-certification.test.mjs test/local-execution-plane-certification.test.mjs test/setup-browser-certification.test.mjs",
      "dependencies": [
        "verify:package"
      ]
    }
  }
}
