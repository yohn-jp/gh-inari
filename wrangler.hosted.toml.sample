name = "gh-inari-hosted-relay"
main = "dist-hosted-worker/hosted-worker.js"
compatibility_date = "2026-09-01"
compatibility_flags = ["nodejs_compat"]

[[routes]]
pattern = "mcp-inari.example.com"
custom_domain = true

[observability]
enabled = true

# No GitHub App, provider, Session, or Runtime credentials are configured here.
[vars]
INARI_HOSTED_REPOSITORY_HOST = "github.com"
INARI_GITHUB_APP_CALLBACK_URL = "https://mcp-inari.example.com/dashboard/oauth/callback"

# Configure separately: `wrangler secret put INARI_GITHUB_APP_CLIENT_SECRET`

[[durable_objects.bindings]]
name = "REPOSITORY_RELAY"
class_name = "RepositoryRelayDurableObject"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RepositoryRelayDurableObject"]
