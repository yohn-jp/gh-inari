#!/usr/bin/env node
import { realpathSync } from "node:fs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const launcherPath = realpathSync(fileURLToPath(import.meta.url));
const extensionDirectory = path.dirname(launcherPath);
const cliPath = path.join(extensionDirectory, "dist", "index.js");
const distributionDirectory = path.join(extensionDirectory, "dist");
const bootstrapAttemptEnvironmentVariable = "GH_INARI_BOOTSTRAP_ATTEMPT";

class LauncherError extends Error {
  constructor(message, options) {
    super(message, options);
    this.name = "LauncherError";
  }
}

function isModuleNotFoundError(error) {
  return error instanceof Error && error.code === "ERR_MODULE_NOT_FOUND";
}

function missingModulePath(error) {
  if (!isModuleNotFoundError(error) || typeof error.url !== "string") return undefined;
  try {
    return fileURLToPath(error.url);
  } catch {
    return undefined;
  }
}

function isPathInside(directory, candidate) {
  const relativePath = path.relative(directory, candidate);
  return (
    relativePath === "" ||
    (relativePath !== ".." && !relativePath.startsWith(`..${path.sep}`) && !path.isAbsolute(relativePath))
  );
}

function isPackagedDistributionError(error) {
  const missingPath = missingModulePath(error);
  return missingPath !== undefined && isPathInside(distributionDirectory, missingPath);
}

function distributionErrorMessage(error) {
  const missingPath = missingModulePath(error) ?? cliPath;
  const displayPath = path.relative(extensionDirectory, missingPath) || missingPath;
  return `gh-inari: packaged distribution is missing or corrupt (${displayPath}). Reinstall the extension or run \"npm run build\".`;
}

function bootstrapDependencies() {
  console.error("gh-inari: installing runtime dependencies for the GitHub CLI extension...");
  const result = spawnSync(
    "npm",
    ["install", "--omit=dev", "--ignore-scripts", "--no-package-lock", "--no-audit", "--no-fund"],
    // npm's own install output must not land on stdout: callers that parse
    // this launcher's stdout as command output (e.g. `--json` consumers)
    // would otherwise see npm's log lines mixed in ahead of the real result.
    { cwd: extensionDirectory, stdio: ["inherit", "ignore", "inherit"] },
  );
  if (result.error !== undefined || result.status !== 0) {
    const detail =
      result.error instanceof Error ? ` ${result.error.message}` : ` npm exited with status ${String(result.status)}.`;
    throw new LauncherError(`gh-inari: unable to install runtime dependencies for the GitHub CLI extension.${detail}`, {
      cause: result.error,
    });
  }
}

function reexecuteAfterBootstrap() {
  // A fresh process is required because Node's ESM loader caches failed
  // resolutions. The sentinel makes the second process a terminal attempt:
  // a broken package cannot recursively reinstall forever.
  const result = spawnSync(process.execPath, [launcherPath, ...process.argv.slice(2)], {
    stdio: "inherit",
    env: { ...process.env, [bootstrapAttemptEnvironmentVariable]: "1" },
  });
  if (result.error !== undefined) {
    throw new LauncherError("gh-inari: unable to restart after installing runtime dependencies.", {
      cause: result.error,
    });
  }
  process.exit(result.status ?? 1);
}

try {
  let cli;
  try {
    cli = await import(pathToFileURL(cliPath).href);
  } catch (error) {
    if (!isModuleNotFoundError(error)) throw error;
    if (isPackagedDistributionError(error)) {
      throw new LauncherError(distributionErrorMessage(error), { cause: error });
    }
    if (process.env[bootstrapAttemptEnvironmentVariable] !== undefined) {
      throw new LauncherError(
        "gh-inari: a runtime dependency is still missing after one bootstrap attempt. Reinstall the extension and try again.",
        { cause: error },
      );
    }
    bootstrapDependencies();
    reexecuteAfterBootstrap();
  }
  process.exitCode = await cli.runCli(process.argv.slice(2));
} catch (error) {
  if (error instanceof LauncherError) {
    console.error(error.message);
    process.exitCode = 1;
  } else if (isModuleNotFoundError(error)) {
    console.error("gh-inari: module not found. Please build the package (npm run build) or reinstall it.");
    process.exitCode = 1;
  } else {
    throw error;
  }
}
